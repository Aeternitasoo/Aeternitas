# Local-only values. Never commit .env or credentials.
SEC_CONTACT=your-real-contact-email
FINNHUB_API_KEY=your-own-finnhub-key
# Existing ChatGPT OAuth; no automatic provider/model/billing fallback.
AETERNITAS_AUTH=chatgpt
AETERNITAS_MODEL=auto
# Optional company API/worker only; Core Workflow needs no DB.
# DATABASE_URL=dbname=aeternitas host=/var/run/postgresql
# Optional metadata-only telemetry; absent credentials => local Recorder.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
# Separate Python 3.13 installed from requirements-memory.lock.
AETERNITAS_MEMORY_PYTHON=
# Absolute path outside the repository.
AETERNITAS_MEMORY_ROOT=
